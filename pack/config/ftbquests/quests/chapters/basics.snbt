			title: "Thin the Horde"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["B62C5B2A7651E4C8"]
			description: [
				"Strip what you can off anything that stops moving. Whatever's left in their pockets is worth more to you now than it ever was to them."
			]
			icon: "kubejs:scavengers_bag"
			id: "908B8B3AE8327895"
			tasks: [{
				consume_items: false
