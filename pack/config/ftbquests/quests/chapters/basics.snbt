			title: "Spoils of War"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["908B8B3AE8327895"]
			description: [
				"A sealed bag is just extra weight. Open it before you decide it wasn't worth carrying."
			]
			icon: "minecraft:chest"
			id: "538A1BBC9A1B8EAC"
