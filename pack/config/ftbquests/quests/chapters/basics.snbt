	quests: [
		{
			description: [
				"If you're reading this, they didn't make it. Doesn't matter who they were. What matters is this: the walls are still standing, the horn still works, and the desert doesn't care either way. Get moving."
			]
			icon: "minecraft:netherite_sword"
			id: "88C119F4CDC56F93"
			rewards: [{
				id: "EDAC534B628CB587"
				type: "xp_levels"
				xp_levels: 2
			}]
			tasks: [{
				id: "3BF8DCAF2F4960C2"
				type: "checkmark"
			}]
			title: "You're On Your Own"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["88C119F4CDC56F93"]
			description: [
				"Notice the notches in that blade? Someone put those there fighting for this exact patch of dirt. The armor's dented in places that matter. None of it was made for you - it was made to last just long enough for whoever's holding it. Don't get comfortable."
			]
			icon: "minecraft:clock"
			id: "CF982E95B58602E4"
			rewards: [{
				id: "8C278819A2A642BF"
				type: "xp_levels"
				xp_levels: 2
			}]
			tasks: [{
				id: "42E75310C2F28FF9"
				type: "checkmark"
			}]
			title: "Borrowed Time"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["CF982E95B58602E4"]
			description: [
				"Out here, waiting is worse than fighting. The horn doesn't summon anything that wasn't already coming - it just decides when. Better you pick the hour than the dark does."
			]
			icon: "kubejs:wave_horn"
			id: "42E42312C8B61976"
			rewards: [
				{
					count: 4
					id: "24A66E75C30766A0"
