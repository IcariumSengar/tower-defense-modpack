			y: 0.0d
		}
		{
			dependencies: ["1454951A7FB14A26"]
			description: [
				"Every wall you're not standing behind yet is still just desert. Clear what's in front of you and the line moves - more ground to hold, more reasons it might not hold."
			]
			icon: "minecraft:map"
			id: "BE3E01220D23C31D"
			rewards: [{
				id: "1C41A9C1424FE8A4"
