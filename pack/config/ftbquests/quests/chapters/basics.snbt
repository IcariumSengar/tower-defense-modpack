					item: "minecraft:oak_log"
					type: "item"
				}
			]
			tasks: [{
				id: "581F189F7A4A833B"
				type: "checkmark"
			}]
			title: "Sound the Horn"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["538A1BBC9A1B8EAC"]
			description: [
				"Whoever manned this post before you didn't leave the pendant behind by choice - it's gone, and the shrine's stood empty since. If it mattered enough to build a stand for, it's worth making another. Melt what gold you can spare and see what comes of it."
			]
			icon: "kubejs:amulet"
			id: "7D3A5F912E6C0B48"
			rewards: [{
				id: "1F84B26D9A5E307C"
				type: "xp_levels"
				xp_levels: 2
