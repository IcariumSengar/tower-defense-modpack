				type: "item"
			}]
			title: "Not Just Jewelry"
			x: 11.0d
			y: 1.5d
		}
		{
			dependencies: ["42E42312C8B61976"]
			description: [
				"Count doesn't matter until it's zero. Five isn't a milestone, it's a start - the desert's got more where these came from, and it isn't running out before you do."
			]
			icon: "minecraft:zombie_head"
			id: "B62C5B2A7651E4C8"
			rewards: [{
				id: "351F6384CED5BB12"
