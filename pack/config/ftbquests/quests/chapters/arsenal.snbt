	quest_links: [ ]
	quests: [
		{
			description: [
				"Every gun works the same way. Left-click fires, right-click aims down the sights, &eR&r reloads from the matching rounds in your inventory, and &eX&r switches between the fire modes that gun has. &eV&r is a melee bash, &eH&r inspects it."
				"Nobody here makes guns: they turn up in supply drops, stash chests and loot bags. Rounds you can make - each kind at a crafting table, from a copper ingot, gunpowder and nuggets."
			]
			icon: {
				Count: 1
				id: "tacz:modern_kinetic_gun"
				tag: {
					GunId: "tacz:glock_17"
				}
			}
			id: "32C94BF025EF564F"
