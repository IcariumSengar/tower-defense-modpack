		{
			dependencies: ["46EBB02979D3B684"]
			hide_until_deps_complete: true
			description: ["Right-click the pedestal holding the amulet to set it down. You lose the buffs and the border opens: you can walk out. To take it back, right-click the pedestal with an empty hand and press &eTake the amulet&r. The horde targets the pedestal either way; what changes is whether you're inside the wall with it. Nothing else goes on the stand; if something ends up there, the same screen hands it back."]
			icon: "supplementaries:pedestal"
