		{
			dependencies: ["67A7BF98D2C077DE"]
			hide_until_deps_complete: true
			description: ["Place a &eLure Block&r and every wave mob within 40 blocks turns off the pedestal and heads for it instead. It lasts 60 seconds, with the time left floating above it and a bell ringing every few seconds while it works, then breaks itself. Break it sooner and it's gone for good. Set it past your spikes so the horde has to walk the line to reach it. A mob you just hit, or one you're standing in front of, still comes for you first."]
			icon: "kubejs:lure_block"
