		}
		{
			dependencies: ["46AB9754465218CF"]
			description: ["The sword and armour you're wearing were theirs. Look close and the wear's already showing - this gear isn't built to last forever. Use it hard while you can; whatever you've found by the time it gives out is what carries you the rest of the way."]
			icon: "minecraft:clock"
			id: "70DA454A61DDC3A1"
