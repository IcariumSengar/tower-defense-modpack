	quests: [
		{
			description: ["Whoever was here before you didn't make it, but they left the place standing - that's not nothing. Sound the horn when you're actually ready, not before. Never did figure out where the horde comes from before it shows up here. Worth keeping an eye out, if you're the type."]
			icon: {
				Count: 1
